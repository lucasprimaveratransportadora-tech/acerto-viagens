generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GESTOR
}

enum TripStatus {
  OK
  PENDENTE
  CANCELADA
}

enum ExpenseCategory {
  DESC_CTE_1
  DESC_CTE_2
  DESC_CTE_3
  DESC_CTE_4
  DESC_CTE_5
  DESC_CTE_6
  ABASTECIMENTO
  COMISSAO_MOTORISTA
  BORRACHARIA
  LIMPEZA
  ESTACIONAMENTO
  CARREGAMENTO
  AGENCIAMENTO
  EXTRAS
  PEDAGIO
  ARLA
  AVARIA
}

enum AttachmentType {
  DOC_CAMINHAO
  DOC_MOTORISTA
  NOTA_ABASTECIMENTO
  CTE_ARQUIVO
  RECIBO
  COMPROVANTE
  OUTRO
}

enum AuditEntity {
  TRIP
  CTE
  FUEL
  EXPENSE
  USER
  TRUCK
  FRETE_TERCEIRO
}

enum FreteTerceiroStatus {
  ABERTO
  PAGO_PARCIAL
  PAGO
  CANCELADO
}

enum FreteTerceiroPagamento {
  INTEGRAL
  ADIANTAMENTO_SALDO
}

enum FreteTerceiroParcela {
  ADIANTAMENTO
  SALDO
  INTEGRAL
  AVULSO
}

enum FreteTerceiroAnexoTipo {
  COMPROVANTE_PAGAMENTO
  CTE
  RECIBO
  OUTRO
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum LoginAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  REFRESH_FAILED
}

model Empresa {
  id         String   @id @default(uuid())
  nome       String
  cnpj       String?  @unique
  logo_url   String?
  ativo      Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  users      User[]
  trucks     Truck[]
  attachments Attachment[]
  audit_logs   AuditLog[]
  login_events LoginEvent[]
  fretes_terceiros FreteTerceiro[]
  @@map("empresas")
}

model User {
  id             String         @id @default(uuid())
  empresa_id     String
  empresa        Empresa        @relation(fields: [empresa_id], references: [id])
  nome           String
  email          String         @unique
  senha_hash     String
  role           Role           @default(GESTOR)
  ativo          Boolean        @default(true)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  refresh_tokens RefreshToken[]
  audit_logs     AuditLog[]
  login_events   LoginEvent[]
  fretes_lancados   FreteTerceiro[] @relation("FreteTerceiroCreated")
  fretes_pagos      FreteTerceiro[] @relation("FreteTerceiroPaid")
  @@index([empresa_id])
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  created_at DateTime @default(now())
  @@index([user_id])
  @@map("refresh_tokens")
}

model Truck {
  id         String      @id @default(uuid())
  empresa_id String
  empresa    Empresa     @relation(fields: [empresa_id], references: [id])
  placa      String      @unique
  modelo     String?
  motorista  String?
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  deleted_at DateTime?
  trips      Trip[]
  attachments Attachment[]
  fretes_terceiros FreteTerceiro[]
  @@index([empresa_id])
  @@map("trucks")
}

model Trip {
  id           String      @id @default(uuid())
  truck_id     String
  truck        Truck       @relation(fields: [truck_id], references: [id])
  data_inicio  DateTime
  data_fim     DateTime?
  origem       String?
  destino      String?
  carga        String?
  km_total     Int         @default(0)
  status       TripStatus  @default(PENDENTE)
  adiantamento Decimal     @default(0) @db.Decimal(12, 2)
  observacoes  String?
  km_inicial   Decimal?    @db.Decimal(12, 2)
  km_final     Decimal?    @db.Decimal(12, 2)
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt
  deleted_at   DateTime?
  ctes         Cte[]
  fuels        Fuel[]
  expenses     Expense[]
  attachments  Attachment[]
  fretes_terceiros FreteTerceiro[]
  @@index([truck_id])
  @@index([data_inicio])
  @@map("trips")
}

model Cte {
  id         String      @id @default(uuid())
  trip_id    String
  trip       Trip        @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  data       DateTime?
  numero     String?
  origem     String?
  destino    String?
  valor      Decimal     @default(0) @db.Decimal(12, 2)
  created_at DateTime    @default(now())
  attachments Attachment[]
  @@index([trip_id])
  @@map("ctes")
}

model Fuel {
  id          String      @id @default(uuid())
  trip_id     String
  trip        Trip        @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  data        DateTime?
  litros      Decimal     @default(0) @db.Decimal(10, 3)
  preco_litro Decimal     @default(0) @db.Decimal(8, 4)
  posto_cnpj  String?
  nota_fiscal String?
  km          Int?
  valor_total Decimal     @default(0) @db.Decimal(12, 2)
  created_at  DateTime    @default(now())
  attachments Attachment[]
  @@index([trip_id])
  @@map("fuels")
}

model Expense {
  id         String          @id @default(uuid())
  trip_id    String
  trip       Trip            @relation(fields: [trip_id], references: [id], onDelete: Cascade)
  categoria  ExpenseCategory
  valor      Decimal         @default(0) @db.Decimal(12, 2)
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt
  @@unique([trip_id, categoria])
  @@index([trip_id])
  @@map("expenses")
}

model Attachment {
  id           String         @id @default(uuid())
  empresa_id   String
  empresa      Empresa        @relation(fields: [empresa_id], references: [id])
  tipo         AttachmentType
  nome_arquivo String
  storage_key  String
  mime_type    String
  tamanho      Int
  truck_id     String?
  truck        Truck?         @relation(fields: [truck_id], references: [id])
  trip_id      String?
  trip         Trip?          @relation(fields: [trip_id], references: [id])
  cte_id       String?
  cte          Cte?           @relation(fields: [cte_id], references: [id])
  fuel_id      String?
  fuel         Fuel?          @relation(fields: [fuel_id], references: [id])
  created_at   DateTime       @default(now())
  @@index([empresa_id])
  @@index([truck_id])
  @@index([trip_id])
  @@map("attachments")
}

model AuditLog {
  id           String       @id @default(uuid())
  empresa_id   String
  empresa      Empresa      @relation(fields: [empresa_id], references: [id])
  actor_id     String?
  actor        User?        @relation(fields: [actor_id], references: [id])
  actor_email  String
  entity_type  AuditEntity
  entity_id    String
  action       AuditAction
  before       Json?
  after        Json?
  ip           String?
  user_agent   String?
  created_at   DateTime     @default(now())

  @@index([empresa_id, created_at(sort: Desc)])
  @@index([entity_type, entity_id])
  @@index([actor_id, created_at(sort: Desc)])
  @@map("audit_logs")
}

model FreteTerceiro {
  id                  String                 @id @default(uuid())
  empresa_id          String
  empresa             Empresa                @relation(fields: [empresa_id], references: [id])

  empresa_pagadora    String
  data                DateTime
  motorista           String
  veiculo             String
  origem              String?
  destino             String?
  truck_id            String?
  truck               Truck?                 @relation(fields: [truck_id], references: [id])

  baixas              FreteTerceiroBaixa[]
  anexos              FreteTerceiroAnexo[]

  valor_total         Decimal                @default(0) @db.Decimal(12, 2)
  valor_adiantamento  Decimal                @default(0) @db.Decimal(12, 2)
  valor_pago          Decimal                @default(0) @db.Decimal(12, 2)

  forma_pagamento     FreteTerceiroPagamento @default(INTEGRAL)
  status              FreteTerceiroStatus    @default(ABERTO)

  data_adiantamento   DateTime?
  data_pagamento      DateTime?

  trip_id             String?
  trip                Trip?                  @relation(fields: [trip_id], references: [id])

  observacoes         String?

  created_by_id       String?
  created_by          User?                  @relation("FreteTerceiroCreated", fields: [created_by_id], references: [id])
  paid_by_id          String?
  paid_by             User?                  @relation("FreteTerceiroPaid",   fields: [paid_by_id],   references: [id])

  created_at          DateTime               @default(now())
  updated_at          DateTime               @updatedAt
  deleted_at          DateTime?

  @@index([empresa_id, created_at(sort: Desc)])
  @@index([truck_id])
  @@index([trip_id])
  @@index([status])
  @@map("fretes_terceiros")
}

model FreteTerceiroBaixa {
  id                String                @id @default(uuid())
  frete_id          String
  frete             FreteTerceiro         @relation(fields: [frete_id], references: [id], onDelete: Cascade)
  valor             Decimal               @db.Decimal(12, 2)
  data_pagamento    DateTime
  parcela           FreteTerceiroParcela  @default(AVULSO)
  observacoes       String?
  baixou_por_id     String?
  created_at        DateTime              @default(now())
  deleted_at        DateTime?

  @@index([frete_id, data_pagamento(sort: Desc)])
  @@map("frete_terceiro_baixas")
}

model FreteTerceiroAnexo {
  id              String                  @id @default(uuid())
  frete_id        String
  frete           FreteTerceiro           @relation(fields: [frete_id], references: [id], onDelete: Cascade)
  tipo            FreteTerceiroAnexoTipo  @default(OUTRO)
  nome            String
  // url externo (Drive, Dropbox, etc.) — usado quando o usuário cola um link
  url             String?
  // upload nativo: bytes do arquivo + metadados. Mutuamente exclusivo com url.
  dados           Bytes?
  mime_type       String?
  tamanho         Int?
  descricao       String?
  created_by_id   String?
  created_at      DateTime                @default(now())
  deleted_at      DateTime?

  @@index([frete_id, created_at(sort: Desc)])
  @@map("frete_terceiro_anexos")
}

model LoginEvent {
  id            String       @id @default(uuid())
  empresa_id    String?
  empresa       Empresa?     @relation(fields: [empresa_id], references: [id])
  user_id       String?
  user          User?        @relation(fields: [user_id], references: [id])
  email_attempt String
  action        LoginAction
  ip            String?
  user_agent    String?
  created_at    DateTime     @default(now())

  @@index([empresa_id, created_at(sort: Desc)])
  @@index([user_id, created_at(sort: Desc)])
  @@index([created_at])
  @@map("login_events")
}
